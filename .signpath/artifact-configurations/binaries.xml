<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "binaries": OwnIDM's own files inside build\Release (zipped by
     actions/upload-artifact). Third-party DLLs in the same zip are left as they are.
     The release workflow passes "version"; product name and version must match on every file. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="OwnIDM.exe" product-name="OwnIDM" product-version="${version}">
      <authenticode-sign />
    </pe-file>
    <pe-file path="OwnIDM.dll" product-name="OwnIDM" product-version="${version}">
      <authenticode-sign />
    </pe-file>
    <pe-file path="OwnIDM.Core.dll" product-name="OwnIDM" product-version="${version}">
      <authenticode-sign />
    </pe-file>
    <pe-file path="OwnIDM.NativeHost.exe" product-name="OwnIDM" product-version="${version}">
      <authenticode-sign />
    </pe-file>
    <pe-file path="OwnIDM.NativeHost.dll" product-name="OwnIDM" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
