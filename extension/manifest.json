{
  "manifest_version": 3,
  "name": "OwnIDM - Integración",
  "description": "Envía las descargas y los vídeos de las páginas a OwnIDM (descarga multi-conexión).",
  "version": "1.4.0",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "OwnIDM",
    "default_popup": "popup.html"
  },
  "permissions": [
    "downloads",
    "cookies",
    "contextMenus",
    "nativeMessaging",
    "storage",
    "webRequest",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "minimum_chrome_version": "109",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "panel.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
