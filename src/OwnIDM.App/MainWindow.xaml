<Window x:Class="OwnIDM.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OwnIDM" Height="620" Width="1080" MinWidth="720" MinHeight="400"
        Icon="Assets/ownidm.ico" FontFamily="Segoe UI" FontSize="13" Background="White"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{x:Static ApplicationCommands.New}" />
        <KeyBinding Key="Delete" Command="{x:Static ApplicationCommands.Delete}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.New}" Executed="OnAddUrl" />
        <CommandBinding Command="{x:Static ApplicationCommands.Delete}" Executed="OnDelete" />
    </Window.CommandBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="White" Padding="4,2">
            <MenuItem Header="_Tareas">
                <MenuItem Header="_Añadir descarga…" InputGestureText="Ctrl+N" Click="OnAddUrl" />
                <MenuItem Header="Abrir archivo _torrent…" Click="OnOpenTorrent" />
                <MenuItem Header="Descarga por _lotes…" Click="OnBatch" />
                <MenuItem Header="_Grabber de sitios…" Click="OnGrabber" />
                <Separator />
                <MenuItem Header="_Importar desde archivo de texto…" Click="OnImport" />
                <MenuItem Header="_Exportar a archivo de texto…" Click="OnExport" />
                <Separator />
                <MenuItem Header="_Salir" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="_Archivo">
                <MenuItem Header="_Reanudar" Click="OnResume" />
                <MenuItem Header="_Detener" Click="OnStop" />
                <MenuItem Header="_Volver a descargar" Click="OnRedownload" />
                <MenuItem Header="_Eliminar" InputGestureText="Supr" Click="OnDelete" />
            </MenuItem>
            <MenuItem Header="_Descargas">
                <MenuItem Header="_Detener todo" Click="OnStopAll" />
                <MenuItem Header="_Eliminar completadas" Click="OnDeleteCompleted" />
                <Separator />
                <MenuItem Header="_Programador…" Click="OnScheduler" />
                <MenuItem Header="_Iniciar cola" Click="OnStartQueue" />
                <MenuItem Header="De_tener cola" Click="OnStopQueue" />
                <Separator />
                <MenuItem x:Name="LimiterMenu" Header="_Limitador de velocidad" IsCheckable="True" Click="OnToggleLimiter" />
                <MenuItem Header="_Opciones…" Click="OnOptions" />
            </MenuItem>
            <MenuItem Header="_Ver">
                <MenuItem x:Name="HideCategoriesMenu" Header="_Ocultar categorías" IsCheckable="True" Click="OnToggleCategories" />
            </MenuItem>
            <MenuItem Header="A_yuda">
                <MenuItem Header="_Buscar actualizaciones…" Click="OnCheckUpdates" />
                <MenuItem Header="_Acerca de OwnIDM" Click="OnAbout" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1" Background="{StaticResource PanelBrush}" Padding="6,4">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolButton}" Tag="&#xE710;" Content="Añadir URL" Click="OnAddUrl" ToolTip="Añadir una nueva descarga (Ctrl+N)" />
                <Button Style="{StaticResource ToolButton}" Tag="&#xE768;" Content="Reanudar" Click="OnResume" ToolTip="Iniciar/reanudar las descargas seleccionadas" />
                <Button Style="{StaticResource ToolButton}" Tag="&#xE769;" Content="Detener" Click="OnStop" ToolTip="Detener las descargas seleccionadas" />
                <Button Style="{StaticResource ToolButton}" Tag="&#xE71A;" Content="Detener todo" Click="OnStopAll" />
                <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="6,4" />
                <Button Style="{StaticResource ToolButton}" Tag="&#xE74D;" Content="Eliminar" Click="OnDelete" />
                <Button Style="{StaticResource ToolButton}" Tag="&#xE73E;" Content="Borrar compl." Click="OnDeleteCompleted" ToolTip="Quitar de la lista las descargas completadas" />
                <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="6,4" />
                <Button x:Name="QueueButton" Style="{StaticResource ToolButton}" Tag="&#xE768;" Content="Iniciar cola" Click="OnToggleQueue" />
                <Button Style="{StaticResource ToolButton}" Tag="&#xE823;" Content="Programador" Click="OnScheduler" ToolTip="Iniciar o detener la cola a una hora" />
                <Button x:Name="LimiterButton" Style="{StaticResource ToolButton}" Tag="&#xEC4A;" Content="Limitador" Click="OnToggleLimiter" />
                <Button Style="{StaticResource ToolButton}" Tag="&#xE8B3;" Content="Lotes" Click="OnBatch" ToolTip="Descarga por lotes (img001.jpg … img100.jpg)" />
                <Button Style="{StaticResource ToolButton}" Tag="&#xE774;" Content="Grabber" Click="OnGrabber" ToolTip="Buscar y descargar archivos de un sitio web" />
                <Button Style="{StaticResource ToolButton}" Tag="&#xE713;" Content="Opciones" Click="OnOptions" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Background="{StaticResource PanelBrush}" Padding="10,4">
            <DockPanel>
                <TextBlock x:Name="TotalSpeedText" DockPanel.Dock="Right" Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedTextBrush}" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CategoryColumn" Width="210" MinWidth="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TreeView x:Name="CategoryTree" BorderThickness="0" Background="{StaticResource PanelBrush}" Padding="4,8"
                      SelectedItemChanged="OnCategoryChanged" />
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}" />

            <DataGrid x:Name="DownloadsGrid" Grid.Column="2" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      GridLinesVisibility="None" BorderThickness="0" Background="White" RowHeight="28"
                      SelectionMode="Extended" CanUserResizeRows="False" AlternatingRowBackground="#FAFBFD"
                      MouseDoubleClick="OnGridDoubleClick">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="Background" Value="White" />
                        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="8,0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentLightBrush}" />
                                <Setter Property="Foreground" Value="Black" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Abrir" Click="OnOpenFile" />
                        <MenuItem Header="Abrir carpeta" Click="OnOpenFolder" />
                        <Separator />
                        <MenuItem Header="Reanudar" Click="OnResume" />
                        <MenuItem Header="Detener" Click="OnStop" />
                        <MenuItem Header="Ver progreso" Click="OnShowProgress" />
                        <MenuItem Header="Volver a descargar" Click="OnRedownload" />
                        <Separator />
                        <MenuItem Header="Añadir a la cola" Click="OnAddToQueue" />
                        <MenuItem Header="Quitar de la cola" Click="OnRemoveFromQueue" />
                        <Separator />
                        <MenuItem Header="Copiar dirección" Click="OnCopyUrl" />
                        <MenuItem Header="Eliminar" Click="OnDelete" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Nombre de archivo" Width="2*" SortMemberPath="FileName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Category, Converter={StaticResource CategoryGlyph}}" FontFamily="{StaticResource IconFont}"
                                               Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Url}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Tamaño" Width="90" Binding="{Binding TotalSize, Converter={StaticResource Bytes}}" SortMemberPath="TotalSize" />
                    <DataGridTemplateColumn Header="Estado" Width="150" SortMemberPath="Status">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Height="18" Background="#EEF2F7" BorderThickness="0"
                                                 Foreground="#9CC3F5" />
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" ToolTip="{Binding ErrorMessage}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource StatusText}">
                                                <Binding Path="Status" />
                                                <Binding Path="Progress" />
                                                <Binding Path="TotalSize" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Tiempo restante" Width="110" Binding="{Binding TimeLeft, Converter={StaticResource Duration}}" />
                    <DataGridTextColumn Header="Velocidad" Width="100" Binding="{Binding Speed, Converter={StaticResource Speed}}" SortMemberPath="Speed" />
                    <DataGridTextColumn Header="Conex." Width="55" Binding="{Binding ActiveConnections}" />
                    <DataGridTextColumn Header="Último intento" Width="130" Binding="{Binding LastTryAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" SortMemberPath="LastTryAt" />
                    <DataGridTextColumn Header="Descripción" Width="*" Binding="{Binding Description}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
