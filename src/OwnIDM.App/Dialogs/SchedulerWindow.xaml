<Window x:Class="OwnIDM.App.SchedulerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Programador" Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner"
        SizeToContent="Manual" Width="860" Height="560" ResizeMode="CanResize" MinWidth="760" MinHeight="480">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="StartNowButton" Content="Iniciar ahora" Style="{StaticResource PrimaryButton}" Click="OnStartNow" />
                <Button x:Name="StopButton" Content="Detener" Style="{StaticResource DialogButton}" Click="OnStop" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Aplicar" Style="{StaticResource DialogButton}" Click="OnApply" />
                <Button Content="Cerrar" Style="{StaticResource DialogButton}" IsCancel="True" Click="OnClose" />
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Schedule -->
            <StackPanel>
                <TextBlock Text="Programación de la cola principal" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />

                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="StartEnabledBox" Content="Iniciar la cola a las" VerticalAlignment="Center" Checked="OnChanged" Unchecked="OnChanged" />
                    <TextBox x:Name="StartTimeBox" Width="64" Margin="8,0,0,0" Height="26" ToolTip="Formato HH:mm" TextChanged="OnChanged" />
                </StackPanel>
                <StackPanel x:Name="StartOptions" Margin="24,8,0,0">
                    <RadioButton x:Name="DailyRadio" Content="Los días marcados" Checked="OnChanged" />
                    <WrapPanel x:Name="DaysPanel" Margin="20,6,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="OnceRadio" Content="Una sola vez, el día" VerticalAlignment="Center" Checked="OnChanged" />
                        <DatePicker x:Name="OnceDatePicker" Margin="8,0,0,0" Width="130" SelectedDateChanged="OnChanged" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <CheckBox x:Name="StopEnabledBox" Content="Detener la cola a las" VerticalAlignment="Center" Checked="OnChanged" Unchecked="OnChanged" />
                    <TextBox x:Name="StopTimeBox" Width="64" Margin="8,0,0,0" Height="26" ToolTip="Formato HH:mm" TextChanged="OnChanged" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <TextBlock Text="Descargas simultáneas" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="ConcurrentBox" Width="50" Height="26" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Al terminar la cola" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="CompletionBox" Width="200" Height="26" />
                </StackPanel>

                <Border Margin="0,16,0,0" Padding="10,8" Background="{StaticResource PanelBrush}" CornerRadius="4">
                    <StackPanel>
                        <TextBlock x:Name="NextStartText" FontWeight="SemiBold" />
                        <TextBlock x:Name="ValidationText" Foreground="Firebrick" TextWrapping="Wrap" Visibility="Collapsed" />
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}"
                                   Text="OwnIDM debe estar abierto a esa hora (basta con el icono de la bandeja). Activa «Iniciar OwnIDM al arrancar Windows» en Opciones." />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Queue contents -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Archivos en la cola (se descargan en este orden)" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
                <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0" Width="110">
                    <Button Content="Subir" Margin="0,0,0,6" Padding="0,4" Click="OnMoveUp" />
                    <Button Content="Bajar" Margin="0,0,0,6" Padding="0,4" Click="OnMoveDown" />
                    <Button Content="Quitar de la cola" Padding="0,4" Click="OnRemoveFromQueue" />
                </StackPanel>
                <ListView x:Name="QueueList" BorderBrush="{StaticResource BorderBrush}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Archivo" Width="230" DisplayMemberBinding="{Binding FileName}" />
                            <GridViewColumn Header="Tamaño" Width="80" DisplayMemberBinding="{Binding TotalSize, Converter={StaticResource Bytes}}" />
                            <GridViewColumn Header="Estado" Width="110">
                                <GridViewColumn.DisplayMemberBinding>
                                    <MultiBinding Converter="{StaticResource StatusText}">
                                        <Binding Path="Status" />
                                        <Binding Path="Progress" />
                                        <Binding Path="TotalSize" />
                                    </MultiBinding>
                                </GridViewColumn.DisplayMemberBinding>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
