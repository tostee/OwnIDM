<Window x:Class="OwnIDM.App.ComponentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Componentes de vídeo" Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="18" Width="480">
        <TextBlock x:Name="ReasonText" TextWrapping="Wrap" />
        <Border Margin="0,12,0,0" Padding="10,8" Background="{StaticResource PanelBrush}" CornerRadius="4">
            <TextBlock x:Name="ListText" Text="Consultando las últimas versiones…" TextWrapping="Wrap" LineHeight="20" />
        </Border>
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,0"
                   Text="Se descargan de sus páginas oficiales en GitHub, se comprueba la suma SHA-256 publicada con cada archivo y se instalan solo para tu usuario, sin permisos de administrador. OwnIDM mantiene yt-dlp actualizado por sí mismo." />
        <ProgressBar x:Name="Bar" Height="14" Margin="0,14,0,0" Foreground="{StaticResource AccentBrush}" Background="#EEF2F7"
                     BorderThickness="0" Visibility="Collapsed" />
        <TextBlock x:Name="StatusText" Margin="0,6,0,0" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="InstallButton" Content="Instalar" Style="{StaticResource PrimaryButton}" IsDefault="True" IsEnabled="False" Click="OnInstall" />
            <Button x:Name="CancelButton" Content="Cancelar" Style="{StaticResource DialogButton}" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
