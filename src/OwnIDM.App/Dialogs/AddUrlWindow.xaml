<ui:FluentWindow x:Class="OwnIDM.App.AddUrlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Introduce la dirección a descargar" Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=UrlBox}">
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" ShowMinimize="False" ShowMaximize="False" />
        <StackPanel Margin="18" Width="520">
            <TextBlock Text="Dirección (URL)" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
            <TextBox x:Name="UrlBox" TextChanged="OnTextChanged" />
            <TextBlock x:Name="Hint" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,6,0,0" Visibility="Collapsed"
                       Text="Introduce una dirección http:// o https:// válida, o un enlace magnet:?" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="OkButton" Content="Aceptar" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnOk" />
                <Button Content="Cancelar" Style="{StaticResource DialogButton}" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</ui:FluentWindow>
