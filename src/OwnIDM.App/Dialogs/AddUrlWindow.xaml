<Window x:Class="OwnIDM.App.AddUrlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Introduce la dirección a descargar" Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=UrlBox}">
    <StackPanel Margin="18" Width="520">
        <TextBlock Text="Dirección (URL)" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
        <TextBox x:Name="UrlBox" Height="30" TextChanged="OnTextChanged" />
        <TextBlock x:Name="Hint" Foreground="#B00020" Margin="0,6,0,0" Visibility="Collapsed"
                   Text="Introduce una dirección http:// o https:// válida, o un enlace magnet:?" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="OkButton" Content="Aceptar" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnOk" />
            <Button Content="Cancelar" Style="{StaticResource DialogButton}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
