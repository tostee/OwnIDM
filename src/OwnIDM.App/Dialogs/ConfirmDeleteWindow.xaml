<ui:FluentWindow x:Class="OwnIDM.App.ConfirmDeleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Confirmar eliminación" Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner">
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" ShowMinimize="False" ShowMaximize="False" />
        <StackPanel Margin="18" Width="440">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
            <CheckBox x:Name="DeleteFilesBox" Margin="0,14,0,0"
                      Content="Borrar también del disco los archivos ya descargados" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Eliminar" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnYes" />
                <Button Content="Cancelar" Style="{StaticResource DialogButton}" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</ui:FluentWindow>
