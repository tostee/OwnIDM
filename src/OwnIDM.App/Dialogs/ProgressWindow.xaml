<ui:FluentWindow x:Class="OwnIDM.App.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:OwnIDM.App"
        Title="Progreso de la descarga" Style="{StaticResource DialogWindow}" Icon="/Assets/ownidm.ico"
        ShowInTaskbar="True" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" ShowMinimize="False" ShowMaximize="False" />
        <StackPanel Margin="18" Width="560">
            <TextBlock x:Name="FileNameText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="UrlText" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,12" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                </Grid.RowDefinitions>
                <TextBlock Text="Estado" Style="{StaticResource FieldLabel}" />
                <TextBlock x:Name="StatusValue" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="1" Text="Tamaño del archivo" Style="{StaticResource FieldLabel}" />
                <TextBlock x:Name="SizeValue" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" />
                <TextBlock Grid.Row="2" Text="Descargado" Style="{StaticResource FieldLabel}" />
                <TextBlock x:Name="DownloadedValue" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" />
                <TextBlock Grid.Row="3" Text="Velocidad" Style="{StaticResource FieldLabel}" />
                <TextBlock x:Name="SpeedValue" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" />
                <TextBlock Grid.Row="4" Text="Tiempo restante" Style="{StaticResource FieldLabel}" />
                <TextBlock x:Name="TimeLeftValue" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" />
                <TextBlock Grid.Row="5" Text="Reanudable" Style="{StaticResource FieldLabel}" />
                <TextBlock x:Name="ResumeValue" Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" />
            </Grid>

            <ProgressBar x:Name="Bar" Margin="0,12,0,0" />

            <Expander x:Name="DetailsExpander" Header="Posiciones de inicio y progreso por conexión" Margin="0,12,0,0" IsExpanded="True">
                <StackPanel Margin="0,8,0,0">
                    <local:SegmentBar x:Name="Segments" Height="16" />
                    <ListView x:Name="ConnectionsList" Height="150" Margin="0,8,0,0" Style="{StaticResource GridListView}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="N.º" Width="40" DisplayMemberBinding="{Binding Number}" />
                                <GridViewColumn x:Name="StartColumn" Header="Inicio" Width="110" DisplayMemberBinding="{Binding Start}" />
                                <GridViewColumn Header="Descargado" Width="110" DisplayMemberBinding="{Binding Downloaded}" />
                                <GridViewColumn Header="Restante" Width="110" DisplayMemberBinding="{Binding Remaining}" />
                                <GridViewColumn Header="Información" Width="150" DisplayMemberBinding="{Binding Info}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </Expander>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="PauseButton" Style="{StaticResource PrimaryButton}" Click="OnPauseResume" />
                <Button Content="Cerrar" Style="{StaticResource DialogButton}" IsCancel="True" Click="OnCloseClick" ToolTip="La descarga continúa en segundo plano" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</ui:FluentWindow>
