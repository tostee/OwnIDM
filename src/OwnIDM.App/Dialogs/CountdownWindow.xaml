<ui:FluentWindow x:Class="OwnIDM.App.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="La cola ha terminado" Style="{StaticResource DialogWindow}" Icon="/Assets/ownidm.ico"
        ShowInTaskbar="True" Topmost="True" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" ShowMinimize="False" ShowMaximize="False" />
        <StackPanel Margin="18" Width="440">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="28" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="MessageText" Margin="12,0,0,0" TextWrapping="Wrap" Width="390" VerticalAlignment="Center" FontSize="14" />
            </StackPanel>
            <ProgressBar x:Name="Bar" Margin="0,16,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="NowButton" Style="{StaticResource PrimaryButton}" Click="OnNow" />
                <Button Content="Cancelar" Style="{StaticResource DialogButton}" IsCancel="True" IsDefault="True" Click="OnCancel" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</ui:FluentWindow>
