<Window x:Class="OwnIDM.App.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Actualización de OwnIDM" Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="18" Width="480">
        <TextBlock x:Name="HeadlineText" TextWrapping="Wrap" FontWeight="SemiBold" />
        <Border x:Name="NotesBorder" Margin="0,12,0,0" Padding="10,8" Background="{StaticResource PanelBrush}" CornerRadius="4">
            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="NotesText" TextWrapping="Wrap" LineHeight="20" />
            </ScrollViewer>
        </Border>
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,0"
                   Text="OwnIDM se cierra, se actualiza y vuelve a abrirse solo. Tu lista de descargas y tus ajustes se conservan; las descargas en curso se detienen y podrás reanudarlas." />
        <ProgressBar x:Name="Bar" Height="14" Margin="0,14,0,0" Foreground="{StaticResource AccentBrush}" Background="#EEF2F7"
                     BorderThickness="0" Visibility="Collapsed" />
        <TextBlock x:Name="StatusText" Margin="0,6,0,0" TextWrapping="Wrap" />
        <DockPanel Margin="0,18,0,0" LastChildFill="False">
            <Button x:Name="SkipButton" DockPanel.Dock="Left" Content="Omitir esta versión" Style="{StaticResource DialogButton}" Margin="0" Click="OnSkip" />
            <Button x:Name="LaterButton" DockPanel.Dock="Right" Content="Más tarde" Style="{StaticResource DialogButton}" Click="OnLater" />
            <Button x:Name="UpdateButton" DockPanel.Dock="Right" Content="Actualizar ahora" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnUpdate" />
        </DockPanel>
    </StackPanel>
</Window>
